# =============================================================================
# Environment variables for Mattermost Docker deployment
# Copy to .env and edit to suit your environment
# =============================================================================

# Timezone inside containers (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=UTC
RESTART_POLICY=unless-stopped

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_DATA_PATH=./volumes/db/var/lib/postgresql/data

POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mmuser_password
POSTGRES_DB=mattermost

# ---------------------------------------------------------------------------
# Mattermost
# ---------------------------------------------------------------------------

# Where to reach the service (used for MM_SERVICESETTINGS_SITEURL)
MM_SERVICESETTINGS_SITEURL=http://localhost:8065

# Host port mapping (set APP_PORT=443 if you front with your own TLS proxy)
APP_PORT=8065
CALLS_PORT=8443

# Paths on the host for persistent volumes
MATTERMOST_CONFIG_PATH=./volumes/app/mattermost/config
MATTERMOST_DATA_PATH=./volumes/app/mattermost/data
MATTERMOST_LOGS_PATH=./volumes/app/mattermost/logs
MATTERMOST_PLUGINS_PATH=./volumes/app/mattermost/plugins
MATTERMOST_CLIENT_PLUGINS_PATH=./volumes/app/mattermost/client/plugins
MATTERMOST_BLEVE_INDEXES_PATH=./volumes/app/mattermost/bleve-indexes

# Make the Mattermost container read-only (advanced — interferes with root.html regeneration)
MATTERMOST_CONTAINER_READONLY=false

# Image tag for the locally built image
MATTERMOST_IMAGE_TAG=latest